msgstr[2] "%(count)s работ добавлено в портфолио."

#: .\users\views.py:903
msgid "Portfolio album created."
msgstr "Альбом портфолио создан."

#: .\users\views.py:987
msgid "Album updated successfully."
msgstr "Альбом успешно обновлён."

#: .\users\views.py:1016
