msgid_plural "%(count)s portfolio works added successfully."
msgstr[0] "Travail ajouté au portfolio."
msgstr[1] "%(count)s travaux ajoutés au portfolio."

msgid "Portfolio album created."
msgstr "Album de portfolio créé."

msgid "Album updated successfully."
msgstr "Album mis à jour avec succès."

msgid "Album deleted. Works were kept in All works."
msgstr "Album supprimé. Les travaux ont été conservés dans Tous les travaux."

msgid "Portfolio work deleted."
msgstr "Travail supprimé du portfolio."

#, python-format
msgid "%(username)s has been approved as a tattoo artist."
msgstr "%(username)s a été approuvé comme tatoueur."

#, python-format
msgid "%(username)s's verification has been rejected."
msgstr "La vérification de %(username)s a été refusée."

msgid "Post report resolved."
msgstr "Signalement de publication traité."

msgid "Reported post deleted."
msgstr "Publication signalée supprimée."

msgid "Comment report resolved."
msgstr "Signalement de commentaire traité."

msgid "Reported comment deleted."
msgstr "Commentaire signalé supprimé."

msgid "You cannot start a chat with yourself."
msgstr "Vous ne pouvez pas démarrer une conversation avec vous-même."

msgid "You cannot access this chat."
msgstr "Vous ne pouvez pas accéder à cette conversation."

msgid "You cannot send messages in this chat."
msgstr "Vous ne pouvez pas envoyer de messages dans cette conversation."

msgid "You cannot send messages to this user."
msgstr "Vous ne pouvez pas envoyer de messages à cet utilisateur."

msgid "You are sending messages too quickly. Please wait a bit."
msgstr "Vous envoyez des messages trop rapidement. Veuillez patienter un peu."

msgid "Message cannot be empty."
msgstr "Le message ne peut pas être vide."

msgid "Message was not edited."
msgstr "Le message n’a pas été modifié."

msgid "Please provide your name, contact email and relation to this location."
msgstr ""
"Indiquez votre nom, votre e-mail de contact et votre lien avec ce lieu."

msgid "Please enter a valid contact email."
msgstr "Saisissez une adresse e-mail de contact valide."

msgid "Upload a PDF, JPG, PNG or WEBP file up to 10 MB."
msgstr "Importez un fichier PDF, JPG, PNG ou WEBP de 10 Mo maximum."

msgid "A claim request for this location is already under review."
msgstr "Une demande de revendication pour ce lieu est déjà en cours d’examen."

msgid ""
"Your claim request was submitted. Tatzo will review it before anything "
"changes."
msgstr ""
"Votre demande de revendication a été envoyée. Tatzo l’examinera avant toute "
"modification."

msgid ""
"Please provide the location name, city, country, full street address, and "
"contact email."
msgstr ""
"Indiquez le nom du lieu, la ville, le pays, l’adresse postale complète et "
"l’e-mail de contact."

msgid "Please enter valid latitude and longitude values."
msgstr "Saisissez des valeurs de latitude et de longitude valides."

msgid "Latitude or longitude is outside the valid range."
msgstr "La latitude ou la longitude est hors de la plage autorisée."

msgid "A location request for this studio is already under review."
msgstr "Une demande de lieu pour ce studio est déjà en cours d’examen."

msgid ""
"Your location request was submitted. Tatzo will review it before it appears "
"on the map."
msgstr ""
"Votre demande de lieu a été envoyée. Tatzo l’examinera avant son affichage "
"sur la carte."

msgid "Registered Tatzo artist with verified/imported location"
msgstr "Artiste Tatzo inscrit avec un lieu vérifié"

msgid "Registered artist without confirmed address"
msgstr "Artiste inscrit sans adresse confirmée"

msgid "Location pending"
msgstr "Lieu en attente de confirmation"

msgid "Imported location"
msgstr "Lieu importé"

msgid "Not yet on Tatzo / Unclaimed"
msgstr "Pas encore sur Tatzo / non revendiqué"

#, python-format
msgid "Pin selected: %(lat)s, %(lng)s"
msgstr "Repère sélectionné : %(lat)s, %(lng)s"

msgid "Verified Tatzo location"
msgstr "Lieu Tatzo vérifié"

msgid "Address pending"
msgstr "Adresse en attente de confirmation"

msgid "Submitting…"
msgstr "Envoi…"

msgid "Use Add location for address review"
msgstr "Utilisez « Ajouter un lieu » pour faire vérifier l’adresse"

msgid ""
"Submit a verification request for this studio. Tatzo will review it before "
"anything changes."
msgstr ""
"Envoyez une demande de vérification pour ce studio. Tatzo l’examinera avant "
"toute modification."

msgid ""
"Submit your address details for review. Nothing is published until Tatzo "
"verifies it."
msgstr ""
"Envoyez les informations de l’adresse pour vérification. Rien ne sera publié "
"avant la validation de Tatzo."

msgid "Find tattoo artists near you and explore studios by location."
msgstr ""
"Trouvez des tatoueurs près de chez vous et explorez les studios par "
"localisation."

msgid "Manage bookings, sessions and upcoming appointments."
msgstr "Gérez vos réservations, vos séances et vos prochains rendez-vous."

msgid "Discover tattoo removal resources, specialists and useful guides."
msgstr ""
"Découvrez des ressources sur le détatouage, des spécialistes et des guides "
"utiles."

msgid "Stay updated about likes, comments, replies and messages."
msgstr "Restez informé des likes, commentaires, réponses et messages."

msgid ""
"Vote for the best tattoo works, follow competitions and discover winners."
msgstr ""
"Votez pour les meilleurs travaux de tatouage, suivez les concours et "
"découvrez les gagnants."

msgid "Thank you! Your report has been sent."
msgstr "Merci ! Votre signalement a été envoyé."
