msgid "Please verify your email before logging in."
msgstr "Veuillez confirmer votre e-mail avant de vous connecter."

msgid "Invalid username or password."
msgstr "Nom d'utilisateur ou mot de passe incorrect."

msgid "This link is invalid or has expired."
msgstr "Ce lien est invalide ou a expiré."

msgid "You are posting too quickly. Please wait a bit."
msgstr "Vous publiez trop rapidement. Veuillez patienter un peu."

msgid ""
"Only image and video files are supported. Please upload JPG, PNG, WEBP, GIF, "
"MP4, MOV or WEBM."
msgstr ""
"Seuls les fichiers image et vidéo sont pris en charge. Importez un fichier "
"JPG, PNG, WEBP, GIF, MP4, MOV ou WEBM."

msgid "This image is too large. Please upload an image under 10 MB."
msgstr ""
"Cette image est trop volumineuse. Importez une image de moins de 10 Mo."

msgid "This video is too large. Please upload a video under 100 MB."
msgstr ""
"Cette vidéo est trop volumineuse. Importez une vidéo de moins de 100 Mo."

msgid "We could not create your post. Please try another file."
msgstr "Nous n’avons pas pu créer votre publication. Essayez un autre fichier."

msgid "Profile updated successfully."
msgstr "Profil mis à jour avec succès."

msgid "Your post has been deleted."
msgstr "Votre publication a été supprimée."

msgid "You cannot delete this post."
msgstr "Vous ne pouvez pas supprimer cette publication."

msgid "You must accept the Terms and Privacy Policy to create an account."
msgstr ""
"Vous devez accepter les conditions et la politique de confidentialité pour "
"créer un compte."

msgid "Too many signup attempts. Please wait a bit and try again."
msgstr ""
"Trop de tentatives d’inscription. Veuillez patienter un peu puis réessayer."

msgid "Account created. Please check your email to confirm your account."
msgstr "Compte créé. Vérifiez votre e-mail pour confirmer votre compte."

msgid "We could not send the confirmation email. Please try again later."
msgstr ""
"Nous n’avons pas pu envoyer l’e-mail de confirmation. Réessayez plus tard."

msgid "You cannot edit this post."
msgstr "Vous ne pouvez pas modifier cette publication."

msgid "Your post has been updated successfully."
msgstr "Votre publication a été mise à jour avec succès."

