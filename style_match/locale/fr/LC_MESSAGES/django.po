msgid "Style Match cards are being prepared. Please try again soon."
msgstr "Les cartes Style Match sont en préparation. Veuillez réessayer bientôt."

msgid "Too many Style Match sessions. Please wait a bit and try again."
msgstr "Trop de sessions Style Match. Patientez un moment puis réessayez."

msgid "Invalid request body."
msgstr "Corps de requête invalide."

msgid "Unknown Style Match action."
msgstr "Action Style Match inconnue."

msgid "A valid card is required."
msgstr "Une carte valide est requise."

msgid "This card is not part of the session."
msgstr "Cette carte ne fait pas partie de la session."

msgid "Please react to the current card first."
msgstr "Veuillez d’abord réagir à la carte actuelle."

msgid "This Style Match is not complete yet."
msgstr "Ce Style Match n’est pas encore terminé."
