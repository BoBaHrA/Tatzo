msgstr "Расскажите о своей татуировке"

msgid "Placement"
msgstr "Расположение"

msgid "Studio note"
msgstr "Заметка студии"

msgid "This time overlaps another event."
msgstr "Это время пересекается с другой записью."

msgid "Studio workspace"
msgstr "Кабинет студии"

msgid "Your studios"
msgstr "Ваши студии"

msgid "Studio navigation"
msgstr "Навигация студии"

msgid "Overview"
msgstr "Обзор"

